EXPO_PUBLIC_GEOAPIFY_API_KEY=

# ---- Firebase (Web app config from Firebase Console) ----
# Prefilled from your google-services.json. appId MUST be your *Web* app id
# (Project Settings -> Your apps -> Web app -> looks like 1:139723049809:web:xxxx).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# ---- Google sign-in ----
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# ---- Backend URL (optional) ----
# Leave empty to use config/api.ts. Must be the backend that contains the
# Firebase /api/auth/sync route. Local example: http://192.168.1.5:5000
EXPO_PUBLIC_API_URL=
